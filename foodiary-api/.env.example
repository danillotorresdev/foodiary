# Cognito
# Use addresses that belong to the same SES verified identity referenced by SES_ARN.
COGNITO_EMAILS_FROM=noreply@your-verified-domain.com
COGNITO_EMAILS_REPLY_TO=support@your-verified-domain.com


# SES
# Example: arn:aws:ses:us-east-1:123456789012:identity/your-verified-domain.com
SES_ARN=

# Route 53
ROUTE53_HOSTED_ZONE_ID=

# API Gateway Custom Domain
DISABLE_DEFAULT_APIGW_ENDPOINT=false
API_DOMAIN_NAME=

# Meals CDN (CloudFront): inclua o arquivo MealsBucketCDN.yml em serverless.yml e preencha:
MEALS_CDN_DOMAIN_NAME=
MEALS_CDN_CERTIFICATE_ARN=

DLQ_ALARM_EMAIL=
